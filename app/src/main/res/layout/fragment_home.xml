<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/city">

    <LinearLayout
        android:id="@+id/button_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_constraintVertical_bias="0.7"
        android:layout_constraintBottom_toBottomOf="parent"
        android:layout_constraintEnd_toEndOf="parent"
        android:layout_constraintStart_toStartOf="parent"
        android:layout_constraintTop_toTopOf="parent"
        android:gravity="center"
        android:orientation="horizontal"
        tools:layout_editor_absoluteX="25dp"
        tools:layout_editor_absoluteY="450dp">

        <Button
            android:id="@+id/btn_emergency_location_fragment"
            android:layout_width="0dp"
            android:layout_height="59dp"
            android:layout_marginEnd="15dp"
            android:layout_weight="1"
            android:backgroundTint="#a81c07"
            android:text="Crises Alert"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btn_emergency_services_fragment"
            android:layout_width="0dp"
            android:layout_height="59dp"
            android:layout_weight="1"
            android:backgroundTint="#a81c07"
            android:text="Emergency Services"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <Button
        android:id="@+id/btn_location_fragment"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:layout_constraintTop_margin="16dp"
        android:layout_constraintTop_toBottomOf="@id/button_container"
        android:layout_constraintEnd_toEndOf="parent"
        android:layout_constraintStart_toStartOf="parent"
        android:background="@drawable/circle_sos_button"
        android:text="SOS"
        android:textColor="#FFFFFF"
        android:textSize="20dp"
        android:textStyle="bold"
        tools:layout_editor_absoluteX="132dp"
        tools:layout_editor_absoluteY="557dp" />
</androidx.constraintlayout.widget.ConstraintLayout>

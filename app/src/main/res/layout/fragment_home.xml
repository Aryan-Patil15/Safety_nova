<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/city"
    tools:context=".MainActivity">

    <!-- Button Container -->
    <LinearLayout
        android:id="@+id/button_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Get Help"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:textSize="30sp"
            android:layout_marginTop="54dp"
            android:layout_gravity="left"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal"
            android:gravity="center">

            <!-- Live Location Button -->
            <Button
                android:id="@+id/btn_liveLocation"
                android:layout_width="0dp"
                android:layout_height="59dp"
                android:layout_weight="1"
                android:layout_marginEnd="15dp"
                android:clickable="true"
                android:focusable="true"
                android:elevation="8dp"
                android:backgroundTint="#a81c07"
                android:text="Live Location Sharing"
                android:textColor="#FFFFFF" />

            <!-- Emergency Services Button -->
            <Button
                android:id="@+id/btn_emergency_services_fragment"
                android:layout_width="0dp"
                android:layout_height="59dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:backgroundTint="#a81c07"
                android:text="Emergency Services"
                android:textColor="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>

    <!-- Centered Image -->
    <ImageView
        android:id="@+id/center"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:src="@drawable/icon"
        android:layout_marginTop="70dp"
        app:layout_constraintTop_toBottomOf="@id/button_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/SOS" />

    <!-- SOS Button -->
    <Button
        android:id="@+id/SOS"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:background="@drawable/circle_sos_button"
        android:clickable="true"
        android:focusable="true"
        android:text="SOS"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/center"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="50dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/city"
    tools:context=".MainActivity">

    <!-- Centered Image -->
    <ImageView
        android:id="@+id/center"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:src="@drawable/icon"
        android:layout_marginTop="120dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Button Container -->
    <LinearLayout
        android:id="@+id/button_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="90dp"
        app:layout_constraintTop_toBottomOf="@id/center"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Live Location Button -->
        <Button
            android:id="@+id/btn_liveLocation"
            android:layout_width="0dp"
            android:layout_height="59dp"
            android:layout_weight="1"
            android:layout_marginEnd="15dp"
            android:clickable="true"
            android:focusable="true"
            android:elevation="8dp"
            android:backgroundTint="#a81c07"
            android:text="Live Location Sharing"
            android:textColor="#FFFFFF" />

        <!-- Emergency Services Button -->
        <Button
            android:id="@+id/btn_emergency_services_fragment"
            android:layout_width="0dp"
            android:layout_height="59dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:backgroundTint="#a81c07"
            android:text="Emergency Services"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <!-- SOS Button -->
    <Button
        android:id="@+id/SOS"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:background="@drawable/circle_sos_button"
        android:clickable="true"
        android:focusable="true"
        android:text="SOS"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginTop="75dp"
        app:layout_constraintTop_toBottomOf="@id/button_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

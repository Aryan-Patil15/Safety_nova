<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".VerifyOtpActivity">

    <!-- Title or Instruction -->
    <TextView
        android:id="@+id/otp_instruction"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Enter the OTP sent to your phone"
        android:textSize="18sp"
        android:textAlignment="center"
        android:textColor="@android:color/black"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/otp_input"
        android:layout_marginBottom="24dp"/>

    <!-- OTP Input Field -->
    <EditText
        android:id="@+id/otp_input"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Enter OTP"
        android:inputType="number"
        android:textAlignment="center"
        android:layout_marginBottom="16dp"
        android:textSize="30dp"
        app:layout_constraintTop_toBottomOf="@id/otp_instruction"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/verify_otp_button"
        android:layout_marginHorizontal="32dp"/>

    <!-- Verify Button -->
    <Button
        android:id="@+id/verify_otp_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Verify OTP"
        android:backgroundTint="@color/purple_500"
        android:textColor="@android:color/white"
        app:layout_constraintTop_toBottomOf="@id/otp_input"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginHorizontal="32dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
